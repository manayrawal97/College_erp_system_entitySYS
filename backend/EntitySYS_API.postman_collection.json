              "raw": "{\n  \"exam_id\": 1,\n  \"grades\": [\n    { \"student_id\": 4, \"marks_obtained\": 42 },\n    { \"student_id\": 5, \"marks_obtained\": 38 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Student Grades (own)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/grades/student/4",
            "header": [{ "key": "Authorization", "value": "Bearer {{student_token}}" }]
          }
        },
        {
          "name": "Course Grades (Faculty)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/grades/course/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{faculty_token}}" }]
          }
        },
        {
          "name": "Update Grade",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/grades/1",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{faculty_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marks_obtained\": 45\n}"
            }
          }
        }
      ]
    },

    {
      "name": "💰 Fees",
      "item": [
        {
          "name": "Pay Exam Fee (Student)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/fees/pay",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{student_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fee_type\": \"exam\",\n  \"exam_id\": 1\n}"
            }
          }
        },
        {
          "name": "Student Payment History",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/fees/student/4",
            "header": [{ "key": "Authorization", "value": "Bearer {{student_token}}" }]
          }
        },
        {
          "name": "All Transactions (Admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/fees/transactions?status=paid&page=1",
              "query": [
                { "key": "status",    "value": "paid" },
                { "key": "fee_type",  "value": "exam",       "disabled": true },
                { "key": "from_date", "value": "2024-01-01", "disabled": true },
                { "key": "to_date",   "value": "2024-12-31", "disabled": true }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        },
        {
          "name": "Generate Receipt",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/fees/generate-receipt",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{student_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_id\": 1\n}"
            }
          }
        },
        {
          "name": "Update Transaction Status (Admin)",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/fees/transactions/1",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"paid\"\n}"
            }
          }
        }
      ]
    },

    {
      "name": "📢 Notices (Real-Time)",
      "item": [
        {
          "name": "Get Notices (Student)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/notices?archived=0&page=1",
              "query": [
                { "key": "archived",   "value": "0" },
                { "key": "course_id",  "value": "1", "disabled": true }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{student_token}}" }]
          }
        },
        {
          "name": "Post College-Wide Notice (Admin)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/notices",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Holiday Announcement\",\n  \"content\": \"The college will remain closed on December 25th for Christmas. Wishing everyone a Merry Christmas!\",\n  \"target_role\": \"all\"\n}"
            }
          }
        },
        {
